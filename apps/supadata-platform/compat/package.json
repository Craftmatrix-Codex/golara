{
  "name": "@golara/sdk-compat",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:sdk": "node --test --test-concurrency=1 suites/*.test.mjs",
    "test:browser": "playwright test --config=playwright.config.mjs",
    "test:recreate": "node recreate-local.mjs",
    "bench:local": "node bench-local.mjs",
    "test:live": "node live-check.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "6.0.2"
  }
}
